# Supabase Credentials (dapatkan dari Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port untuk Express backend lokal
PORT=5000

# Opsional: override URL API untuk frontend (default dev: http://localhost:5000/api/seats, prod: /api/seats)
# VITE_API_URL=http://localhost:5000/api/seats
